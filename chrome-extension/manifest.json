{
  "manifest_version": 3,
  "name": "JobPilot AI — Send Job",
  "version": "1.0.0",
  "description": "Send the current job posting to JobPilot AI with one click.",
  "permissions": ["activeTab", "storage", "scripting", "cookies"],
  "host_permissions": [
    "http://localhost:8000/*",
    "https://*/*",
    "https://www.linkedin.com/*",
    "https://linkedin.com/*"
  ],
  "action": {
    "default_title": "Send to JobPilot",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://*/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
