# Application
APP_NAME=JobPilot AI
APP_ENV=development
DEBUG=true
SECRET_KEY=replace-with-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
API_V1_PREFIX=/api/v1

# MongoDB
MONGODB_URL=mongodb://mongodb:27017
MONGODB_DB=jobpilot

# Redis
REDIS_URL=redis://redis:6379/0

# Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_CLIENT_ID=jobpilot-api
KAFKA_GROUP_ID=jobpilot-workers

# CORS (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost

# Rate limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# Automation
SCHEDULER_INTERVAL_SECONDS=3600
MATCH_THRESHOLD=0.7
MAX_APPLICATIONS_PER_DAY=50
PLAYWRIGHT_HEADLESS=true
UPLOAD_DIR=/tmp/jobpilot/uploads
SCREENSHOT_DIR=/tmp/jobpilot/screenshots
REPORT_DIR=/tmp/jobpilot/reports

# Observability
LOG_LEVEL=INFO
PROMETHEUS_ENABLED=true

# Frontend
VITE_API_URL=/api/v1
