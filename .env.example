# Application
APP_NAME=JobPilot AI
APP_ENV=development
DEBUG=true
SECRET_KEY=replace-with-openssl-rand-hex-32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7
API_V1_PREFIX=/api/v1

# MongoDB
MONGODB_URL=mongodb://mongodb:27017
MONGODB_DB=jobpilot

# Redis
REDIS_URL=redis://redis:6379/0
REDIS_MAX_CONNECTIONS=50
REDIS_CACHE_TTL_SECONDS=60
REDIS_HOT_TTL_SECONDS=300

# Celery
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# Mongo pool
MONGODB_MAX_POOL_SIZE=50
MONGODB_MIN_POOL_SIZE=5

# OpenTelemetry (optional)
OTEL_ENABLED=false
OTEL_EXPORTER_ENDPOINT=http://otel-collector:4317

# Process model
WEB_CONCURRENCY=2
GUNICORN_TIMEOUT=60

# LLM ranking
LLM_ENABLED=false
LLM_API_URL=https://api.openai.com/v1/chat/completions
LLM_API_KEY=
LLM_MODEL=gpt-4o-mini

# S3 object storage
S3_ENABLED=false
S3_BUCKET=
S3_REGION=us-east-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_ENDPOINT_URL=
S3_PUBLIC_BASE_URL=

# Captcha / 2FA
CAPTCHA_PROVIDER=noop
CAPTCHA_API_KEY=
CAPTCHA_API_URL=https://api.2captcha.com/createTask
CAPTCHA_RESULT_URL=https://api.2captcha.com/getTaskResult
TOTP_TEST_CODE=

# Email alerts
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@jobpilot.ai
SMTP_TLS=true

# Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_CLIENT_ID=jobpilot-api
KAFKA_GROUP_ID=jobpilot-workers

# CORS (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost

# Rate limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# Automation
SCHEDULER_INTERVAL_SECONDS=3600
MATCH_THRESHOLD=0.7
MAX_APPLICATIONS_PER_DAY=50
PLAYWRIGHT_HEADLESS=true
UPLOAD_DIR=/tmp/jobpilot/uploads
SCREENSHOT_DIR=/tmp/jobpilot/screenshots
REPORT_DIR=/tmp/jobpilot/reports

# Observability
LOG_LEVEL=INFO
PROMETHEUS_ENABLED=true

# Frontend
VITE_API_URL=/api/v1
